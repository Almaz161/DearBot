# =========================================
# Twitch app credentials (https://dev.twitch.tv/console/apps)
# =========================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Login of the channel the bot watches (your channel)
TWITCH_CHANNEL=your_channel_login

# Login of the account that posts messages in chat.
# Use your own login or a separate bot account. Empty = same as TWITCH_CHANNEL.
TWITCH_BOT_LOGIN=

# OAuth token storage path (auto-managed by `npm run auth`)
TWITCH_TOKENS_FILE=./data/tokens.json

# =========================================
# Channel Points reward logging
# =========================================
# Comma-separated reward IDs whose redemptions get logged to redemptions.csv / DB.
# Leave empty to log every custom reward.
# Reward IDs are visible in dashboard URL when editing the reward, or via API/EventSub logs.
LOG_REWARD_IDS=

# Reward ID that triggers a song request from the user input text (optional).
# When this reward is redeemed, user_input is treated as `!sr <text>`.
MUSIC_REWARD_ID=

# =========================================
# Music
# =========================================
# Maximum song duration in seconds (default: 600 = 10 min). Longer videos are rejected.
MUSIC_MAX_DURATION=600
# Maximum simultaneous requests per viewer (default: 2).
MUSIC_PER_USER_LIMIT=2
# Whether non-mods can use !sr (default: true).
MUSIC_ALLOW_VIEWERS=true

# =========================================
# Overlay HTTP/WS server (OBS Browser Source)
# =========================================
OVERLAY_PORT=4488
# Secret token appended to the overlay URL. Anyone with this URL can see the queue,
# so keep it private. Auto-generated on first run if left blank.
OVERLAY_TOKEN=

# =========================================
# Optional: Google Sheets logging via Apps Script Web App.
# See README "Google Sheets" section for the Apps Script to paste.
# =========================================
GOOGLE_SHEETS_WEBHOOK=

# =========================================
# Optional: Discord webhook for redemption mirror
# =========================================
DISCORD_WEBHOOK_URL=

# =========================================
# Misc
# =========================================
LOG_LEVEL=info

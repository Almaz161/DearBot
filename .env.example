# Most settings live in data/config.json — entered via the in-app /setup wizard.
# This .env file only holds optional bootstrap values; copy to .env if you want
# to skip the wizard or pre-seed credentials.

# Port the bot web server listens on. Railway/Render/Fly set $PORT automatically;
# locally we default to 4488.
OVERLAY_PORT=4488

# Public URL the bot is reachable at (used to build the OAuth redirect URI shown
# in the wizard, and the OBS overlay URL). On Railway/Render/Fly the wizard can
# auto-detect this from the request — leave blank in that case.
# Example: https://my-bot.up.railway.app
PUBLIC_URL=

# Optional. The wizard sets these for you; only fill them in if you want to
# bypass the wizard.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_BOT_LOGIN=

# Optional Channel Points reward filters (the wizard manages these too).
LOG_REWARD_IDS=
MUSIC_REWARD_ID=

# Music
MUSIC_MAX_DURATION=600
MUSIC_PER_USER_LIMIT=2
MUSIC_ALLOW_VIEWERS=true

# Optional integrations (wizard manages Google Sheets).
GOOGLE_SHEETS_WEBHOOK=
DISCORD_WEBHOOK_URL=

# Misc
LOG_LEVEL=info

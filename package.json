{
  "name": "twitch-bot",
  "version": "1.0.0",
  "description": "Twitch bot: logs Channel Points reward redemptions and plays viewer music requests in an OBS browser-source overlay.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/overlay/public', 'dist/src/overlay/public', { recursive: true }); cpSync('src/setup/public', 'dist/src/setup/public', { recursive: true });\"",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "auth": "tsx scripts/auth.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["twitch", "bot", "obs", "channel-points", "music"],
  "license": "MIT",
  "dependencies": {
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.20.1",
    "yt-search": "^2.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
